# Copy to .env and fill in, OR leave empty: the suite registers its own test account on the
# first run and writes the values here. .env is gitignored - never commit real credentials.

# App under test. The API is a SEPARATE host - not BASE_URL + /api.
BASE_URL=
API_BASE_URL=

# Account used for every test. global-setup logs in once and saves the session to
# .auth/user.json; no test performs a login.
EMAIL=
PASSWORD=
USERNAME=
