{
  "name": "testability-assignment-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end Playwright suite for the Conduit demo app (Testability assignment).",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foyezkabir/Testability-Automation---Playwright.git"
  },
  "scripts": {
    "test": "playwright test",
    "test:ci": "CI=1 playwright test",
    "test:parallel": "playwright test --workers=4",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "playwright-smart-reporter": "^2.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
